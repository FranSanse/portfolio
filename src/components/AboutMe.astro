---
import '../styles/global.css';
import {useTranslations} from '../i18n/ui.ts';
import foto from '../assets/foto.png';
import {Image} from 'astro:assets';

const ruta = Astro.url.pathname;

const esIngles = ruta.startsWith('/en');

const t = useTranslations(ruta);


---

<div id="sobre-mi" class="flex flex-row">
    <div  class="flex flex-col text-white font-bold gap-5">
        <p>{t('texto.sobremi.p1')}</p>
        <p>{t('texto.sobremi.p2')}</p>
    </div>
    <div>
        <Image src={foto} alt={t('meta.title')} width="500" height="500" />
    </div>
</div>