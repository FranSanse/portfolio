---
import '../styles/global.css';
import { useTranslations } from '../i18n/ui';
import esPro from '../i18n/proyectos.es.json';
import enPro from '../i18n/proyectos.en.json';

const ruta = Astro.url.pathname;

const esIngles = ruta.startsWith('/en');

const t = useTranslations(ruta);

interface ProjectLinks{
    github?: string | null;
    pdf?: string | null;
    playstore?: string | null;
    demo?: string | null;
}

interface Proyecto {
    titulo: string;
    subtitulo: string;
    imagen: string;
    descripcion: string[];
    stack: string[];
    links: ProjectLinks;
}

const proyectos: Proyecto[] = (esIngles ? enPro : esPro) as Proyecto[];

---

<div id="experiencia" class="flex flex-col items-center w-full py-28 scroll-mt-36 mx-auto px-4 md:px-8 max-w-7xl">
    <h1 class="uppercase text-white text-2xl md:text-4xl font-['Unbounded']">{t('projects')}</h1>