---
import '../styles/global.css';
import { useTranslations } from '../i18n/ui';
import esPro from '../i18n/proyectos.es.json';
import enPro from '../i18n/proyectos.en.json';

const ruta = Astro.url.pathname;

const esIngles = ruta.startsWith('/en');

const t = useTranslations(ruta);

interface ProjectLinks{
    github?: string | null;
    pdf?: string | null;
    playstore?: string | null;
    demo?: string | null;
}

interface Proyecto {
    titulo: string;
    subtitulo: string;
    imagen: string;
    descripcion: string[];
    stack: string[];
    links: ProjectLinks;
}

const proyectos: Proyecto[] = (esIngles ? enPro : esPro) as Proyecto[];

---

<div id="proyectos" class="flex flex-col items-center w-full py-28 scroll-mt-36 mx-auto px-4 md:px-8 max-w-7xl">
    <h1 class="uppercase text-white text-2xl md:text-4xl font-['Unbounded'] tracking-wide mb-12">{t('projects')}</h1>
    <div class="flex flex-col gap-10 w-full max-w-5xl">
        {proyectos.map((proyecto) => (
            <article class="flex flex-col w-full min-h-75 bg-slate-900/60 border border-slate-800 rounded-2xl p-5 sm:p-7 transiton duration-300 hover:border-slate-700/80 backdrop-blur-sm shadow-xl">
                <div class="flex flex-col md:grid md:grid-cols-12 gap-6 items-start">
                    <div class="w-full md:col-span-5 rounded-xl overflow-hidden border border-slate-800 aspect-video flex items-center justify-center shrink-0">
                        <img src={proyecto.imagen} alt={proyecto.titulo} class="w-full h-full object-contain transition-transform duration-500 hover:scale-105" loading="lazy">
                    </div>
                    <div class="w-full md:col-span-7 flex flex-col gap-3">
                        <h3 class="text-xl sm:text-2xl font-bold font-['Space Grotesk'] text-white tracking-wide">
                            {proyecto.titulo}
                        </h3>
                        <p class="text-xs md:text-sm font-['JetBrains_Mono'] text-cyan-400 mt-1">
                            {proyecto.subtitulo}
                        </p>
                    </div>
                </div>
            </article>
        ))}
    </div>
</div>