---
import '../styles/global.css';
import { useTranslations } from '../i18n/ui';
import esPro from '../i18n/proyectos.es.json';
import enPro from '../i18n/proyectos.en.json';
import {Icon} from "astro-icon/components";

const ruta = Astro.url.pathname;

const esIngles = ruta.startsWith('/en');

const t = useTranslations(ruta);

interface ProjectLinks{
    label?: string | null;
    url?: string | null;
    icon?: string | null;
}

interface Proyecto {
    titulo: string;
    subtitulo: string;
    imagen: string;
    descripcion: string[];
    stack: string[];
    links: ProjectLinks[];
}

const proyectos: Proyecto[] = (esIngles ? enPro : esPro) as Proyecto[];

---

<div id="proyectos" class="flex flex-col items-center w-full py-28 scroll-mt-36 mx-auto px-4 md:px-8 max-w-7xl">
    <h1 class="uppercase text-white text-2xl md:text-4xl font-['Unbounded'] tracking-wide mb-12">{t('projects')}</h1>
    <div class="flex flex-col gap-10 w-full max-w-5xl">
        {proyectos.map((proyecto) => (
            <article class="group flex flex-col w-full min-h-75 bg-slate-900/60 border border-slate-800 rounded-2xl p-5 sm:p-7 hover:-translate-y-1 hover:border-slate-700/80 hover:shadow-[0_0_8px_rgba(255,255,255,0.5)] backdrop-blur-sm shadow-xl">
                <div class="flex flex-col md:grid md:grid-cols-12 gap-6 items-start">
                    <div class="w-full md:col-span-5 overflow-hidden flex items-center justify-center shrink-0">
                        <img src={proyecto.imagen} alt={proyecto.titulo} class="rounded-xl w-auto h-auto max-w-full max-h-[380px] transition-transform duration-500 hover:scale-105" loading="lazy">
                    </div>
                    <div class="w-full md:col-span-7 flex flex-col gap-3">
                        <h3 class="text-xl sm:text-2xl font-bold font-['Space Grotesk'] text-white tracking-wide">
                            {proyecto.titulo}
                        </h3>
                        <p class="text-sm md:text-base font-medium font-['JetBrains_Mono',monospace] text-cyan-400 tracking-wide mt-1">
                            {proyecto.subtitulo}
                        </p>
                        <ul class="w-full space-y-2">
                            {proyecto.descripcion.map((i) => (
                                <li class="flex items-start gap-2.5 leading-relaxed transition-transform duration-200 hover:translate-x-1">
                                    <div class="w-1.5 h-1.5 shrink-0 rounded-full bg-sky-500 mt-2 hover:bg-cyan-400 transition-colors group-hover:shadow-[0_0_8px_rgba(56,189,248,0.8)]"/>
                                    <span class="text-slate-300 font-['Outfit'] text-sm sm:text-base">{i}</span>
                                </li>
                            ))
                                }
                        </ul>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 items-end w-full border-t border-white/10 pt-6 pb-2 mt-5 gap-4">
                    <div class="w-full flex flex-wrap items-center justify-center sm:justify-start gap-2">
                    { proyecto.stack.map((i) =>(
                        <div class="inline-flex items-center justify-center rounded-full text-xs md:text-sm border bg-sky-500/5 border-cyan-400/50 hover:bg-sky-500/20 hover:border-cyan-300 hover:-translate-y-0.5  transition-all duration-200 px-2.5 py-0.5 sm:px-3.5 sm:py-1">
                            <span class="text-zinc-300 font-['Space_Grotesk'] text-xs md:text-sm whitespace-nowrap">{i}</span>
                        </div>
                    ))
                    }
                    </div>
                    <div class="w-full flex flex-wrap items-center justify-center sm:justify-end gap-4">
                        {proyecto.links.map((i) =>(
                            i.url &&(
                                <a href={i.url} target="_blank" rel="noopener noreferrer" class="group/btn inline-flex items-center gap-2 py-2 px-2 cursor-pointer bg-blue-500/80 w-auto h-auto justify-center rounded-lg hover:bg-blue-300/80 border border-sky-300/40 hover:border-white shadow-sm  hover:shadow-[0_0_12px_rgba(147,197,253,0.6)] transition-all duration-200">
                                    <Icon name={i.icon} class="w-3.5 h-3.5 sm:w-5 sm:h-5 text-white"></Icon>
                                    <span class="text-white group-hover/btn:text-slate-950 font-['Space_Grotesk'] text-xs md:text-sm whitespace-nowrap">{i.label}</span>
                                </a>
                            )
                        ))
                        }
                    </div>
                </div>
            </article>
        ))}
    </div>
</div>