<canvas id="canvas-network"></canvas>

<style>
    #canvas-network{
        position:fixed;
        top:0;
        left:0;
        height: 100vh;
        width: 100vw;
        z-index: 0;
        pointer-events:none;
        background-color: transparent;
    }
</style>

<script>
    const canvas = document.getElementById("canvas-network") as HTMLCanvasElement;
    const contexto = canvas.getContext("2d");

    if (contexto){
        let particulas : Particula[] = [];

        const ancho = window.innerWidth;
        const alto = window.innerHeight;

        const area = ancho * alto;

        const distanciaMaxima = Math.min(Math.floor(ancho*0.05+110),185);
        const distanciaMaximaCuadrado = distanciaMaxima * distanciaMaxima;
        const numeroParticulas = Math.min(Math.floor(area/11000),180);

        const resize = () => {
            canvas.height = window.innerHeight;
            canvas.width = window.innerWidth;
        };

        window.addEventListener('resize',resize);
        resize();

        class Particula{
            x : number;
            y : number;
            vx : number;
            vy : number;
            radio : number;

            constructor(){
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.vx = (Math.random() - 0.5) * 0.5;
                this.vy = (Math.random() - 0.5) * 0.5;
                this.radio = Math.random() * 1.5 + 1;
            }

            actualizar(){
                this.x += this.vx;
                this.y += this.vy
                if (this.x < 0 || this.x > canvas.width){
                    this.vx = -this.vx;
                }

                if (this.y < 0 || this.y > canvas.height){
                    this.vy = -this.vy;
                }
            }
        }

        for(let i = 0; i < numeroParticulas; i++){   
            particulas.push(new Particula());
        }

        const animacion = () =>{
            contexto.clearRect(0,0,canvas.width,canvas.height);
            contexto.fillStyle = "#38bdf8";
            contexto.beginPath();
            for(let i = 0; i < particulas.length; i++){
                const p = particulas[i];
                p.actualizar();
                contexto.moveTo(p.x+p.radio,p.y);
                contexto.arc(p.x,p.y,p.radio,0,Math.PI*2);
            }
            contexto.fill();

            for(let i = 0; i < particulas.length; i++){
                for(let j = i+1 ; j< particulas.length; j++){
                    const dx = particulas[i].x - particulas[j].x;
                    const dy = particulas[i].y - particulas[j].y;
                    const distanciaCuadrado = dx*dx + dy*dy;

                    if (distanciaCuadrado < distanciaMaximaCuadrado){
                        const opacidad = (1 - (Math.sqrt(distanciaCuadrado)/distanciaMaxima));
                        contexto.strokeStyle = `rgba(56, 189, 248, ${opacidad * 0.25})`;
                        contexto.lineWidth = 1;
                        contexto.beginPath();
                        contexto.moveTo(particulas[i].x,particulas[i].y);
                        contexto.lineTo(particulas[j].x,particulas[j].y);
                        contexto.stroke();
                    }
                }
            }
            requestAnimationFrame(animacion);
        }
        animacion();
    }
</script>