---
import '../styles/global.css';
import '@fontsource/bodoni-moda';
import '@fontsource/instrument-serif';
import '@fontsource/playfair-display';
import { useTranslations } from '../i18n/ui';
import {Icon} from "astro-icon/components";

const ruta = Astro.url.pathname;

const esIngles = ruta.startsWith('/en');

const t = useTranslations(ruta);

---

<footer class="flex flex-row justify-between z-50 bg-slate-950/70 w-full items-center backdrop-blur-xs px-6 xl:px-12 py-5 border-t border-slate-800/40 gap-5">
      
        <div class="gap-1 flex flex-col">
            <p class="text-zinc-400 text-xs uppercase font-medium font-space-mono">{t('text.copyright')}</p>
        </div>
        
        <div class="flex items-center gap-6">
            <a href="https://github.com/FranSanse" target="_blank" rel="noopener noreferrer" class="inline-flex items-center cursor-pointer w-9 h-9 justify-center bg-blue-500/80 rounded-full hover:bg-blue-300/80 border border-sky-300/40 hover:border-white shadow-sm  hover:shadow-[0_0_12px_rgba(147,197,253,0.6)] transition-all duration-200">
                <Icon name="mdi:github" class="w-5 h-5 text-white"></Icon>
            </a>
            <!-- <a href="" target="_blank" rel="noopener noreferrer" class="inline-flex items-center cursor-pointer w-9 h-9 justify-center bg-blue-500/80 rounded-full hover:bg-blue-300/80 border border-sky-300/40 hover:border-white shadow-sm  hover:shadow-[0_0_12px_rgba(147,197,253,0.6)] transition-all duration-200">
                <Icon name="fa6-brands:x-twitter" class="w-5 h-5 text-white"></Icon> 
            </a>-->
            <a href="https://www.linkedin.com/in/franciscoivansansegundo/" target="_blank" rel="noopener noreferrer"class="inline-flex items-center gap-2 cursor-pointer bg-blue-500/80 w-9 h-9 justify-center rounded-full hover:bg-blue-300/80 border border-sky-300/40 hover:border-white shadow-sm  hover:shadow-[0_0_12px_rgba(147,197,253,0.6)] transition-all duration-200">
                <Icon name="mdi:linkedin" class="w-5 h-5 text-white"></Icon>
            </a>
        </div>       
</footer>
