---
import '../styles/global.css';

import { useTranslations } from '../i18n/ui';

const ruta = Astro.url.pathname;

const esIngles = ruta.startsWith('/en');

const t = useTranslations(ruta);

interface Experiencia {
    duracion: String;
    rol: String;
    companya: String;
    descripcion: String[];
    stack: String[];
}

---

<div id="experiencia" class="flex flex-col items-center w-full py-20 scroll-mt-36 mx-auto px-4 md:px-8 max-w-7xl">
    <h1 class="uppercase text-white text-2xl md:text-4xl font-['Unbounded']">{t('experience')}</h1>
    <div class="flex flex-row w-full gap-12 items-center mt-12">
    <h1 class="uppercase text-white text-base md:text-lg font-['Unbounded']">2026</h1>
    </div>
</div>



