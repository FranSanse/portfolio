---
import '../styles/global.css';
import { useTranslations } from '../i18n/ui';
import esExp from '../i18n/experiencia.es.json';
import enExp from '../i18n/experiencia.en.json';

const ruta = Astro.url.pathname;

const esIngles = ruta.startsWith('/en');

const t = useTranslations(ruta);

interface Experiencia {
    duracion: string;
    rol: string;
    empresa: string;
    localizacion: string;
    descripcion: string[];
    stack: string[];
}

const experiencias :Experiencia[] = (esIngles ? enExp : esExp) as Experiencia[] ;

---

<div id="experiencia" class="flex flex-col items-center w-full py-28 scroll-mt-36 mx-auto px-4 md:px-8 max-w-7xl">
    <h1 class="uppercase text-white text-2xl md:text-4xl font-['Unbounded']">{t('experience')}</h1>
    { experiencias.map((item) =>(
        <div class="group flex flex-col md:flex-row w-full gap-4 md:gap-6 mt-8 md:mt-12">
            <span class="hidden md:flex uppercase text-zinc-400 whitespace-nowrap text-lg md:text-xl font-['JetBrains_Mono'] transition-all group-hover:text-slate-100">{item.duracion}</span>
            <div class=" hidden relative md:flex flex-col items-center">
                <div class="w-4 h-4 rounded-full border-2 shrink-0 border-sky-500/40 bg-slate-900 z-10 mt-1 transition-all group-hover:border-cyan-400 group-hover:bg-cyan-400 group-hover:shadow-[0_0_12px_rgba(56,189,248,0.8)]"></div>
                <div class="w-[2px] flex-1 bg-sky-500/40 transition-all group-hover:bg-sky-400 group-hover:shadow-[0_0_12px_rgba(56,189,248,0.8)]"></div>
            </div>
            <div class="flex flex-col w-full bg-slate-900/80 backdrop-blur-md border border-white/10 rounded-xl transition-all group-hover:shadow-[0_0_8px_rgba(255,255,255,0.5)]">
                <span class="flex md:hidden uppercase text-zinc-400 pl-4 mt-2 whitespace-nowrap text-lg md:text-xl font-['JetBrains_Mono',monospace] transition-all group-hover:text-slate-100">{item.duracion}</span>
                <h2 class="text-white font-['Outfit'] text-lg md:text-xl py-4 px-4">{item.rol}</h2>
                <div class="w-full px-4 gap-4 flex flex-row items-center">
                    <span class="text-cyan-500 font-['Space_Grotesk'] text-sm md:text-base">{item.empresa}</span>
                    <div class="w-1 h-1 rounded-full shrink-0 bg-white"></div>
                    <span class="text-zinc-300 font-['Space_Grotesk'] text-sm md:text-base">{item.localizacion}</span>
                </div>
                <ul class="px-4 py-2 w-full space-y-2">
                    { item.descripcion.map((i) =>(
                        <li class="flex items-start gap-2.5 leading-relaxed transition-transform duration-200 hover:translate-x-1"> 
                            <div class="w-1.5 h-1.5 rounded-full shrink-0 bg-sky-500 hover:bg-cyan-400 transition-colors group-hover:shadow-[0_0_8px_rgba(56,189,248,0.8)] mt-2"></div>
                            <span class="text-slate-300 font-['Outfit'] font-light text-sm md:text-base">{i}</span>
                        </li>
                    ))
                    }
                </ul>
                <div class="w-full grid grid-cols-2 md:grid-cols-4 xl:grid-cols-7 gap-3 px-4 my-4">
                    { item.stack.map((i) =>(
                        <div class="flex justify-center rounded-full text-sm md:text-base border bg-sky-500/5 border-cyan-400/50 hover:bg-sky-500/20 hover:border-cyan-300 hover:-translate-y-0.5  transition-all duration-200 w-full px-4">
                            <span class="text-zinc-300 font-['Space_Grotesk'] text-sm md:text-base">{i}</span>
                        </div>
                    ))
                }
                </div>
            </div>
        </div>
        ))
    }
</div>