<!-- Contenedor que va a contener al elemento, en este caso va a ser un punto brillante -->
<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
    <!-- Blob 1 -->
    <div class=" blob-1 absolute -top-24 -left-24 h-96 w-96 rounded-full bg-indigo-600/15 blur-[80px]"></div>
     <!-- Blob 1 -->
    <div class="blob-2 absolute -bottom-24 -right-24 h-96 w-96 rounded-full bg-cyan-500/15 blur-[85px]"></div>
</div>

<style>
    .blob-1{
        animation: float-blob-1 18s alternate infinite ease-in-out
    }

    .blob-2{
        animation: float-blob-2 18s alternate infinite ease-in-out
    }

    @keyframes float-blob-1{
        0%{
            transform: translate(0px,0px) scale(1);
        }
        50%{
            transform: translate(60px,40px) scale(1.20);
        }
        100%{
            transform: translate(-30px,70px) scale(0.80);
        }
    }

      @keyframes float-blob-2{
        0%{
            transform: translate(0px,0px) scale(1);
        }
        50%{
            transform: translate(-70px,-50px) scale(0.85);
        }
        100%{
            transform: translate(40px,-30px) scale(1.15);
        }
    }


</style>
