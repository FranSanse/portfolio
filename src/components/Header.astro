---
import '../styles/global.css';
import { useTranslations } from '../i18n/ui';

const ruta = Astro.url.pathname;

const esIngles = ruta.startsWith('/en');

const t = useTranslations(ruta);

const etiquetaMostrar = esIngles ? 'ES' : 'EN';

const archivoDescarga = esIngles ? '/CV_ingles.pdf' : '/CV.pdf';

const rutaMostrar = esIngles ? '/' : '/en';
---

<header class="fixed flex flex-row justify-between top-0 left-0 right-0 z-50 bg-slate-950/70 w-full items-center backdrop-blur-xs px-6 md:px-18 xl:px-32 py-3 border-b border-slate-800/40">
      
        <div class="gap-1 flex flex-col">
            <h1 class="text-white text-lg md:text-xl xl:text-2xl uppercase font-bold font-[Unbounded] drop-shadow-[0_0_12px_rgba(56,189,248,0.6)] leading-tight">
                <a href={esIngles ? '/en' : '/'} class="hover:text-sky-400 transition-colors cursor-pointer">Francisco Iván <br/> San Segundo</a>
            </h1>
            <h2 class="text-zinc-400 text-xs md:text-sm xl:text-base uppercase tracking-widest font-bold font-space-mono">{t('role')}</h2>
        </div>

        <nav class="items-center flex flex-row gap-4 hidden xl:flex">
            <a href="#sobre-mi" class="relative text-zinc-300 text-base xl:text-lg cursor-pointer hover:text-white transition-colors pb-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-white after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-500">{t('about')}</a>
            <a href="#experiencia" class="relative text-zinc-300 text-base xl:text-lg cursor-pointer hover:text-white transition-colors pb-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-white after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-500">{t('experience')}</a>
            <a href="#proyectos" class="relative text-zinc-300 text-base xl:text-lg cursor-pointer hover:text-white transition-colors pb-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-white after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-500">{t('projects')}</a>
            <a href="#stack" class="relative text-zinc-300 text-base xl:text-lg cursor-pointer hover:text-white transition-colors pb-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-white after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-500">{t('stack')}</a>
            <a href="#contacto" class="whitespace-nowrap relative text-zinc-300 text-base xl:text-lg cursor-pointer hover:text-white transition-colors pb-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-white after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-500">{t('contact')}</a>
        </nav>
        
        <div class="flex items-center gap-3 sm:gap-6 hidden xl:flex">
            <a href={rutaMostrar} class="text-zinc-400 font-mono text-lg cursor-pointer hover:text-white rounded px-2 py-1 transition-colors">{etiquetaMostrar}</a>
            <a href={archivoDescarga} download={esIngles ? "CV_Francisco_Ivan_San_Segundo_Alvarez_en.pdf" : "CV_Francisco_Ivan_San_Segundo_Alvarez.pdf"} class="inline-flex items-center gap-2 text-slate-100 font-mono text-lg cursor-pointer uppercase text-center bg-blue-500/80 px-3.5 py-1.5 rounded-[14px] hover:bg-blue-300/80 border border-sky-300/40 hover:border-white shadow-sm  hover:shadow-[0_0_12px_rgba(147,197,253,0.6)] transition-all duration-200">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 15V3"/>
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <path d="m7 10 5 5 5-5"/>
                </svg>
                <span>{t('btn.cv')}</span>
            </a>
        </div>

        <button id="menu-toggle" aria-label ={t('menu.toggle')} class="text-white p-2 focus:outline-none xl:hidden cursor-pointer">
            <svg id="icon-burger" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16 M4 12h16 M4 18h16"></path>
            </svg>
            <svg id="icon-cross" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 L18 6 M6 6 L18 18">
                </path>
            </svg>
        </button>

        <div id="menu" class="hidden xl:hidden absolute top-full left-0 w-full bg-slate-900/70 backdrop-blur-xs shadow-[0_8px_20px_rgba(0,0,0,0.25)] border-b border-slate-700/50 px-6 py-6">
            <nav class= "items-start flex flex-col gap-4">
                <a href="#sobre-mi" class="inline-block relative text-zinc-300 text-base xl:text-lg cursor-pointer hover:text-white transition-colors pb-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-white after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-500">{t('about')}</a>
                <a href="#experiencia" class="inline-block relative text-zinc-300 text-base xl:text-lg cursor-pointer hover:text-white transition-colors pb-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-white after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-500">{t('experience')}</a>
                <a href="#proyectos" class="inline-block relative text-zinc-300 text-base xl:text-lg cursor-pointer hover:text-white transition-colors pb-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-white after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-500">{t('projects')}</a>
                <a href="#stack" class="inline-block relative text-zinc-300 text-base xl:text-lg cursor-pointer hover:text-white transition-colors pb-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-white after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-500">{t('stack')}</a>
                <a href="#contacto" class="inline-block relative text-zinc-300 text-base xl:text-lg cursor-pointer hover:text-white transition-colors pb-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-white after:scale-x-0 hover:after:scale-x-100 after:origin-left after:transition-transform after:duration-500">{t('contact')}</a>
            </nav>
        
            <div class="flex items-center gap-3 gap-6 mt-12">
                <a href={rutaMostrar} class="text-zinc-400 font-mono text-lg cursor-pointer hover:text-white rounded px-2 py-1 transition-colors">{etiquetaMostrar}</a>
                <a href={archivoDescarga} download={esIngles ? "CV_Francisco_Ivan_San_Segundo_Alvarez_en.pdf" : "CV_Francisco_Ivan_San_Segundo_Alvarez.pdf"} class="inline-flex items-center gap-2 text-slate-100 font-mono text-lg cursor-pointer uppercase text-center bg-blue-500/80 px-3.5 py-1.5 rounded-[14px] hover:bg-blue-300/80 border border-sky-300/40 hover:border-white shadow-sm  hover:shadow-[0_0_12px_rgba(147,197,253,0.6)] transition-all duration-200">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 15V3"/>
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <path d="m7 10 5 5 5-5"/>
                    </svg>
                    <span>{t('btn.cv')}</span>
                </a>
            </div>
        </div>
</header>

<script>
    const menuToggle = document.getElementById('menu-toggle');
    const iconBurger = document.getElementById('icon-burger');
    const iconClose = document.getElementById('icon-cross');
    const menu = document.getElementById('menu');

    menuToggle?.addEventListener('click',() => {
        iconBurger?.classList.toggle('hidden');
        iconClose?.classList.toggle('hidden');
        menu?.classList.toggle('hidden');
    });
</script>
